{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/hakkimizda", "destination": "/hakkimizda.html" },
    { "source": "/hizmetlerimiz", "destination": "/hizmetlerimiz.html" },
    { "source": "/galeri", "destination": "/galeri.html" },
    { "source": "/iletisim", "destination": "/iletisim.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
