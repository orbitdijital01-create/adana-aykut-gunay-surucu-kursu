{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/hakkimizda", "destination": "/hakkimizda.html" },
    { "source": "/hizmetlerimiz", "destination": "/hizmetlerimiz.html" },
    { "source": "/galeri", "destination": "/galeri.html" },
    { "source": "/iletisim", "destination": "/iletisim.html" },
    { "source": "/adana-surucu-kursu", "destination": "/index.html" },
    { "source": "/yuregir-surucu-kursu", "destination": "/index.html" },
    { "source": "/adana-ehliyet-kursu", "destination": "/hizmetlerimiz.html" },
    { "source": "/adana-psikoteknik", "destination": "/hizmetlerimiz.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
